{
  "manifest_version": 3,
  "name": "Context — Live captions decoded",
  "short_name": "Context",
  "version": "1.0.0",
  "description": "Leggi i sottotitoli nativi di Google Meet, clicca una parola, scopri il significato. Sincronizzato con l'app mobile e web.",
  "icons": {
    "16": "icons/icon-16.png",
    "48": "icons/icon-48.png",
    "128": "icons/icon-128.png"
  },
  "action": {
    "default_popup": "popup/popup.html",
    "default_title": "Context",
    "default_icon": {
      "16": "icons/icon-16.png",
      "48": "icons/icon-48.png"
    }
  },
  "background": {
    "service_worker": "background/service-worker.js",
    "type": "module"
  },
  "content_scripts": [
    {
      "matches": ["https://meet.google.com/*"],
      "js": ["content/content.js"],
      "css": ["content/content.css"],
      "run_at": "document_idle",
      "all_frames": false
    }
  ],
  "permissions": ["storage", "activeTab"],
  "host_permissions": [
    "https://meet.google.com/*",
    "https://premium-subtitles.preview.emergentagent.com/*"
  ],
  "web_accessible_resources": [
    {
      "resources": ["content/content.css", "icons/*"],
      "matches": ["https://meet.google.com/*"]
    }
  ]
}
